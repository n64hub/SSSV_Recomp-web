diff --git a/src/gbi/sssv_mirror.h b/src/gbi/sssv_mirror.h
new file mode 100644
index 0000000000000000000000000000000000000000..cad690bba09623e976571d75c2fba1d4d1a876cf
--- /dev/null
+++ b/src/gbi/sssv_mirror.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <unordered_set>
+
+namespace RT64::SSSVMirror {
+    inline std::atomic_bool enabled{false};
+    // Immutable after startup. These are native RT64 TMEM hashes, so the rule
+    // applies to both original textures and their optional HD replacements.
+    inline std::unordered_set<uint64_t> readableTextures;
+
+    inline void loadRules(const std::filesystem::path& path) {
+        readableTextures.clear();
+        std::ifstream file(path);
+        std::string line;
+        while (std::getline(file, line)) {
+            line.erase(line.find('#') == std::string::npos ? line.size() : line.find('#'));
+            std::istringstream row(line);
+            uint32_t width, height;
+            std::string source, partner;
+            if (!(row >> width >> height >> source >> partner) || width == 0 || height == 0) continue;
+            try {
+                size_t end = 0;
+                const auto hash = std::stoull(source, &end, 16);
+                if (end != source.size() || source != partner) continue;
+                readableTextures.insert(hash);
+            } catch (const std::exception&) { }
+        }
+    }
+
+    inline bool readable(uint64_t hash) { return readableTextures.find(hash) != readableTextures.end(); }
+    inline bool worldProjection(uint32_t id) {
+        return id == 0x1000u || id == 0x1020u || id == 0x1021u;
+    }
+    inline bool worldGroup(uint32_t id) {
+        return id >= 0x01000000u && id < 0x04000000u;
+    }
+}
diff --git a/src/gbi/sssv_terminal_feedback.h b/src/gbi/sssv_terminal_feedback.h
new file mode 100644
index 0000000000000000000000000000000000000000..188330d05e55c8aa6ad70956e619e792411d44e9
--- /dev/null
+++ b/src/gbi/sssv_terminal_feedback.h
@@ -0,0 +1,12 @@
+#pragma once
+#include <cmath>
+#include <cstdint>
+
+namespace SSSVTerminalFeedback {
+    // Preserve transmittance over one native frame when the same MSAA target
+    // is faded once for each interpolated display frame.
+    inline float fadeAlpha(float alpha, uint32_t nativeRate, uint32_t displayRate) {
+        if (nativeRate == 0 || displayRate <= nativeRate || alpha <= 0.0f || alpha >= 1.0f) return alpha;
+        return 1.0f - std::pow(1.0f - alpha, float(nativeRate) / float(displayRate));
+    }
+}
