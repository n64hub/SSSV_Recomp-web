diff --git a/ultramodern/include/ultramodern/speed_clock.hpp b/ultramodern/include/ultramodern/speed_clock.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..2be581d588e557470e963b9a65c5527796b1e1f4
--- /dev/null
+++ b/ultramodern/include/ultramodern/speed_clock.hpp
@@ -0,0 +1,17 @@
+#pragma once
+#include <cstdint>
+namespace ultramodern {
+class SpeedClock {
+    int64_t anchor_real = 0;
+    int64_t anchor_game = 0;
+    uint32_t rate = 1;
+public:
+    int64_t now(int64_t real_ns) const { return anchor_game + (real_ns - anchor_real) * rate; }
+    void set(int64_t real_ns, uint32_t new_rate) {
+        anchor_game = now(real_ns);
+        anchor_real = real_ns;
+        rate = new_rate == 2 || new_rate == 4 || new_rate == 8 || new_rate == 16 ? new_rate : 1;
+    }
+    uint32_t speed() const { return rate; }
+};
+}
